<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android">

    <!-- A-3: rein lokale Tages-Erinnerung — Runtime-Abfrage im Editor bzw.
         Re-Planung des Alarms nach einem Neustart. Keine Netzwerk-Berechtigung. -->
    <uses-permission android:name="android.permission.POST_NOTIFICATIONS" />
    <uses-permission android:name="android.permission.RECEIVE_BOOT_COMPLETED" />

    <application
        android:allowBackup="true"
        android:dataExtractionRules="@xml/data_extraction_rules"
        android:fullBackupContent="@xml/backup_rules"
        android:icon="@mipmap/ic_launcher"
        android:label="@string/app_name"
        android:roundIcon="@mipmap/ic_launcher_round"
        android:supportsRtl="true"
        android:theme="@style/Theme.PositiveParentingReminders"
        >
        <activity
            android:name="com.positiveparenting.onboarding.OnboardingActivity"
            android:exported="true"
            android:theme="@style/Theme.PositiveParentingReminders">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />

                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity>
        <activity
            android:name="com.positiveparenting.onboarding.OnboardingStep2Activity"
            android:exported="false"
            android:theme="@style/Theme.PositiveParentingReminders" />
        <activity
            android:name="com.positiveparenting.onboarding.OnboardingStep3Activity"
            android:exported="false"
            android:theme="@style/Theme.PositiveParentingReminders" />
        <activity
            android:name="com.positiveparenting.onboarding.ProfileSetupActivity"
            android:exported="false"
            android:theme="@style/Theme.PositiveParentingReminders" />
        <activity
            android:name="com.positiveparenting.journal.JournalEditorActivity"
            android:exported="false"
            android:theme="@style/Theme.PositiveParentingReminders"
            android:windowSoftInputMode="stateVisible|adjustResize" />
        <activity
            android:name="com.positiveparenting.journal.JournalOverviewActivity"
            android:exported="false"
            android:theme="@style/Theme.PositiveParentingReminders" />

        <!-- Täglicher Impuls (A-3): Alarm-Empfänger + Re-Planung nach
             Neustart/Zeitänderung (geschützte System-Broadcasts, daher
             exported="false"). -->
        <receiver
            android:name="com.positiveparenting.reminder.DailyReminderReceiver"
            android:exported="false" />
        <receiver
            android:name="com.positiveparenting.reminder.ReminderRescheduleReceiver"
            android:exported="false">
            <intent-filter>
                <action android:name="android.intent.action.BOOT_COMPLETED" />
                <action android:name="android.intent.action.TIME_SET" />
                <action android:name="android.intent.action.TIMEZONE_CHANGED" />
            </intent-filter>
        </receiver>
    </application>

</manifest>