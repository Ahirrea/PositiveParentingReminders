<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/animation_background"
    android:fillViewport="true"
    android:fitsSystemWindows="true"
    tools:context=".journal.JournalEditorActivity">

    <androidx.constraintlayout.widget.ConstraintLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:padding="24dp">

        <TextView
            android:id="@+id/date_textview"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_marginTop="16dp"
            android:textAppearance="@style/TextAppearance.AppCompat.Caption"
            android:textColor="@color/white"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toTopOf="parent"
            tools:text="Samstag, 1. August 2026" />

        <TextView
            android:id="@+id/prompt_textview"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_marginTop="8dp"
            android:textAppearance="@style/TextAppearance.AppCompat.Headline"
            android:textColor="@color/white"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toBottomOf="@id/date_textview"
            tools:text="Wann warst du heute stolz auf dich?" />

        <com.google.android.material.textfield.TextInputLayout
            android:id="@+id/entry_text_input_layout"
            style="@style/Widget.Material3.TextInputLayout.OutlinedBox"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_marginTop="24dp"
            android:hint="@string/journal_editor_text_hint"
            android:textColorHint="@color/white"
            app:boxStrokeColor="@color/white"
            app:hintTextColor="@color/white"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toBottomOf="@id/prompt_textview">

            <com.google.android.material.textfield.TextInputEditText
                android:id="@+id/entry_text_edittext"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:gravity="top"
                android:importantForAutofill="no"
                android:inputType="textMultiLine|textCapSentences"
                android:minLines="5"
                android:textColor="@color/white" />

        </com.google.android.material.textfield.TextInputLayout>

        <TextView
            android:id="@+id/mood_label_textview"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_marginTop="24dp"
            android:text="@string/journal_editor_mood_label"
            android:textAppearance="@style/TextAppearance.AppCompat.Body1"
            android:textColor="@color/white"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toBottomOf="@id/entry_text_input_layout" />

        <com.google.android.material.button.MaterialButtonToggleGroup
            android:id="@+id/mood_toggle_group"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_marginTop="8dp"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toBottomOf="@id/mood_label_textview"
            app:selectionRequired="false"
            app:singleSelection="true">

            <com.google.android.material.button.MaterialButton
                android:id="@+id/mood_button_1"
                style="?attr/materialButtonOutlinedStyle"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:backgroundTint="@color/mood_button_background"
                android:contentDescription="@string/mood_1_description"
                android:insetBottom="0dp"
                android:insetTop="0dp"
                android:minHeight="56dp"
                android:minWidth="0dp"
                android:paddingBottom="14dp"
                android:paddingTop="0dp"
                android:textColor="@color/white"
                android:text="@string/mood_1_emoji"
                android:textSize="20sp"
                app:icon="@drawable/mood_button_icon"
                app:iconGravity="textTop"
                app:iconPadding="2dp"
                app:iconSize="12dp"
                app:iconTint="@color/white"
                app:strokeColor="@color/white" />

            <com.google.android.material.button.MaterialButton
                android:id="@+id/mood_button_2"
                style="?attr/materialButtonOutlinedStyle"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:backgroundTint="@color/mood_button_background"
                android:contentDescription="@string/mood_2_description"
                android:insetBottom="0dp"
                android:insetTop="0dp"
                android:minHeight="56dp"
                android:minWidth="0dp"
                android:paddingBottom="14dp"
                android:paddingTop="0dp"
                android:textColor="@color/white"
                android:text="@string/mood_2_emoji"
                android:textSize="20sp"
                app:icon="@drawable/mood_button_icon"
                app:iconGravity="textTop"
                app:iconPadding="2dp"
                app:iconSize="12dp"
                app:iconTint="@color/white"
                app:strokeColor="@color/white" />

            <com.google.android.material.button.MaterialButton
                android:id="@+id/mood_button_3"
                style="?attr/materialButtonOutlinedStyle"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:backgroundTint="@color/mood_button_background"
                android:contentDescription="@string/mood_3_description"
                android:insetBottom="0dp"
                android:insetTop="0dp"
                android:minHeight="56dp"
                android:minWidth="0dp"
                android:paddingBottom="14dp"
                android:paddingTop="0dp"
                android:textColor="@color/white"
                android:text="@string/mood_3_emoji"
                android:textSize="20sp"
                app:icon="@drawable/mood_button_icon"
                app:iconGravity="textTop"
                app:iconPadding="2dp"
                app:iconSize="12dp"
                app:iconTint="@color/white"
                app:strokeColor="@color/white" />

            <com.google.android.material.button.MaterialButton
                android:id="@+id/mood_button_4"
                style="?attr/materialButtonOutlinedStyle"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:backgroundTint="@color/mood_button_background"
                android:contentDescription="@string/mood_4_description"
                android:insetBottom="0dp"
                android:insetTop="0dp"
                android:minHeight="56dp"
                android:minWidth="0dp"
                android:paddingBottom="14dp"
                android:paddingTop="0dp"
                android:textColor="@color/white"
                android:text="@string/mood_4_emoji"
                android:textSize="20sp"
                app:icon="@drawable/mood_button_icon"
                app:iconGravity="textTop"
                app:iconPadding="2dp"
                app:iconSize="12dp"
                app:iconTint="@color/white"
                app:strokeColor="@color/white" />

            <com.google.android.material.button.MaterialButton
                android:id="@+id/mood_button_5"
                style="?attr/materialButtonOutlinedStyle"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:backgroundTint="@color/mood_button_background"
                android:contentDescription="@string/mood_5_description"
                android:insetBottom="0dp"
                android:insetTop="0dp"
                android:minHeight="56dp"
                android:minWidth="0dp"
                android:paddingBottom="14dp"
                android:paddingTop="0dp"
                android:textColor="@color/white"
                android:text="@string/mood_5_emoji"
                android:textSize="20sp"
                app:icon="@drawable/mood_button_icon"
                app:iconGravity="textTop"
                app:iconPadding="2dp"
                app:iconSize="12dp"
                app:iconTint="@color/white"
                app:strokeColor="@color/white" />

        </com.google.android.material.button.MaterialButtonToggleGroup>

        <TextView
            android:id="@+id/theme_label_textview"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_marginTop="24dp"
            android:text="@string/journal_editor_theme_label"
            android:textAppearance="@style/TextAppearance.AppCompat.Body1"
            android:textColor="@color/white"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toBottomOf="@id/mood_toggle_group" />

        <!-- Themen-Chips (A-5): zur Laufzeit aus ThemeCatalog.KEYS + theme_labels
             befüllt. singleSelection + selectionRequired="false" heißt: ein Tipp
             wählt, ein zweiter hebt wieder auf. -->
        <com.google.android.material.chip.ChipGroup
            android:id="@+id/theme_chip_group"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_marginTop="8dp"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toBottomOf="@id/theme_label_textview"
            app:selectionRequired="false"
            app:singleSelection="true" />

        <com.google.android.material.button.MaterialButton
            android:id="@+id/save_entry_button"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_marginTop="32dp"
            android:enabled="false"
            android:padding="16dp"
            android:text="@string/journal_editor_save_button"
            android:textColor="@color/save_button_text"
            app:backgroundTint="@color/save_button_background"
            app:layout_constraintBottom_toTopOf="@id/journal_overview_button"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toBottomOf="@id/theme_chip_group"
            app:layout_constraintVertical_bias="1.0" />

        <com.google.android.material.button.MaterialButton
            android:id="@+id/journal_overview_button"
            style="@style/Widget.Material3.Button.TextButton"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_marginTop="4dp"
            android:minHeight="48dp"
            android:text="@string/journal_editor_overview_button"
            android:textColor="@color/white"
            app:layout_constraintBottom_toBottomOf="parent"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toBottomOf="@id/save_entry_button" />

    </androidx.constraintlayout.widget.ConstraintLayout>
</ScrollView>
