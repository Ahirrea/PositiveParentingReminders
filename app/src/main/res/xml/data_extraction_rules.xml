<?xml version="1.0" encoding="utf-8"?><!--
   Kein Eintrag verlässt jemals das Gerät (PRD Erfolgskriterien, A-1):
   die Room-Datenbank ist von Googles Cloud-Backup und vom Gerätetransfer
   ausgeschlossen. Gerätewechsel löst später A-9 (Export) sauber.
-->
<data-extraction-rules>
    <cloud-backup>
        <exclude domain="database" path="." />
    </cloud-backup>
    <device-transfer>
        <exclude domain="database" path="." />
    </device-transfer>
</data-extraction-rules>
