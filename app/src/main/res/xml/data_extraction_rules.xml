<?xml version="1.0" encoding="utf-8"?><!--
   Backup/transfer rules for API 31+ (minSdk is 33, so these are the ones in effect).
   The journal database is excluded from cloud backup AND device transfer:
   entries must never leave the device (PRD success criteria). Device migration
   is solved cleanly by A-9 (export).
-->
<data-extraction-rules>
    <cloud-backup>
        <exclude domain="database" path="journal.db" />
        <exclude domain="database" path="journal.db-wal" />
        <exclude domain="database" path="journal.db-shm" />
    </cloud-backup>
    <device-transfer>
        <exclude domain="database" path="journal.db" />
        <exclude domain="database" path="journal.db-wal" />
        <exclude domain="database" path="journal.db-shm" />
    </device-transfer>
</data-extraction-rules>
