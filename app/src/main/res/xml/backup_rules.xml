<?xml version="1.0" encoding="utf-8"?><!--
   Backup rules for API < 31 (see data_extraction_rules.xml for API 31+).
   The journal database is excluded: entries must never leave the device
   (PRD success criteria). Device migration is solved cleanly by A-9 (export).
-->
<full-backup-content>
    <exclude domain="database" path="journal.db" />
    <exclude domain="database" path="journal.db-wal" />
    <exclude domain="database" path="journal.db-shm" />
</full-backup-content>
